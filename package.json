{
  "name": "the-baby-insider",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n velite,next -c magenta,cyan \"velite dev\" \"next dev\"",
    "build": "velite build --clean && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "content": "velite build --clean",
    "audit:disclosure": "node scripts/audit-disclosure.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "next": "15.5.9",
    "posthog-js": "^1.203.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "schema-dts": "^1.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vercel/speed-insights": "^1.1.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.9",
    "feed": "^4.2.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3",
    "unist-util-visit": "^5.0.0",
    "velite": "^0.3.0"
  }
}
